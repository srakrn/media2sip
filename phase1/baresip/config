# baresip config for pbx-ha-media phase 1 PoC.
# Deliberately minimal: only the modules a paging UA actually needs.

poll_method             select

# --- SIP ---
sip_listen              0.0.0.0:5062
sip_trans_def           udp

# --- call ---
call_local_timeout      120
call_max_calls          4
call_accept             no

# --- audio ---
# audio_source is rewritten per run by phase1/page.sh (aufile = play a WAV into the call).
audio_source            aufile,/Users/srakrn/Repositories/pbx-ha-media/phase1/sounds/chime.wav
audio_player            coreaudio,default
audio_alert             coreaudio,default
audio_srate             8000-48000
audio_channels          1-2
ausrc_srate             8000
auplay_srate            8000

# --- RTP ---
rtp_tx_enable           yes
rtp_ports               20000-20100
rtp_timeout             60
avt_bundle              no

module_path             /opt/homebrew/lib/baresip/modules

# codecs
module                  g711.so
module                  l16.so
# audio driver + file source
module                  coreaudio.so
module                  aufile.so
module                  auconv.so
module                  auresamp.so

module_app              account.so
module_app              contact.so
module_app              menu.so
module_app              debug_cmd.so

module                  stdio.so
module                  ctrl_tcp.so

ctrl_tcp_listen         127.0.0.1:4444
