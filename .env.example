# SIP account the sidecar registers as. One ordinary extension created in the
# PBX GUI - no dialplan, no manager user.
SIP_EXTENSION=9901
SIP_SECRET=
PBX_HOST=10.1.2.99
PBX_PORT=5060

# Home Assistant. Only needed for development and for the integration; the
# sidecar itself never needs these, because TTS proxy URLs carry their own token.
HA_URL=http://homeassistant.local:8123
HA_TOKEN=

# Optional sidecar tuning.
#SIDECAR_PORT=8080
#SIP_LOCAL_PORT=5062
#RTP_PORT_START=20000
#RTP_PORT_COUNT=100
#LEAD_IN=1.0
#API_TOKEN=
# Set only when running bridged behind NAT against a PBX without symmetric RTP.
#SIP_PUBLIC_ADDRESS=
